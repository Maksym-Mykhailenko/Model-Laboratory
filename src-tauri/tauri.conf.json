{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Laboratory",
  "version": "1.17.0",
  "identifier": "org.modellaboratory.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Model Laboratory",
        "width": 1480,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Reproducible mathematical experiments",
    "longDescription": "A desktop laboratory for validated mathematical models, analysis, visualisation, and portable reproducible experiments.",
    "externalBin": [
      "binaries/model-lab-engine"
    ],
    "fileAssociations": [
      {
        "ext": ["mlab"],
        "mimeType": "application/x-model-laboratory",
        "description": "Model Laboratory experiment",
        "role": "Editor"
      },
      {
        "ext": ["yaml", "yml"],
        "mimeType": "application/yaml",
        "description": "Model Laboratory model source",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
